 "jevy": {
  "system": "Markets and data",
  "gate": [
   "cd zig && zig build test --summary all",
   "cd zig && zig build -Doptimize=ReleaseFast",
   "python3 -m venv .ops-venv && .ops-venv/bin/pip install -q -r requirements.lock && .ops-venv/bin/pip install -q -e . --no-deps && .ops-venv/bin/python -m pytest -q"
  ],
  "timeout": 1800
 },
 "finance-segway": {
  "system": "Markets and data",
  "gate": [
   "python3 -m venv .ops-venv && .ops-venv/bin/pip install -q -r requirements.txt && .ops-venv/bin/python -m unittest discover -s tests -q",
   ".ops-venv/bin/python tools/build_all_models.py > .ops-bam.json && grep -q '\"parity_failed\": 0' .ops-bam.json && grep -q '\"presentation_parity_failed\": 0' .ops-bam.json && echo parity-27-27"
  ],
  "meters": [
   "exhaustion"
  ],
  "timeout": 1800
 },
